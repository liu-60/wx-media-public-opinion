ilities": ["hotword-aggregate", "standalone", "cross-platform-match", "hotword-filter-rules", "tolerant-hotword-merge", "canonical-hotword-evidence", "title-overlap-dedupe"], "run_mode": "standalone", "required_artifacts": [], "credential_ref": "SUPABASE_SECRET_KEY", "code_hash": "" },
