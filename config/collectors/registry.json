            "type": "integer",
            "label": "最少命中平台数",
            "min": 2,
            "max": 50
          },
          "canonical_hotwords": {
            "type": "array",
            "label": "固定热词归并规则",
            "description": "例如闲鱼使用prefix将闲鱼暗、闲鱼公等候选归并到闲鱼，并保留matched_terms证据。"
          },
          "merge_consistency_threshold": {
            "type": "number",
            "label": "相似热词合并一致性阈值",
            "description": "0.8 示例：相似热词的文章证据一致性达到 80% 才合并；如“体操男团/体操男”共同覆盖 4/5 篇文章时合并。",
            "min": 0,
            "max": 1
