      "entrypoint": "scripts/collectors/tophub-hotwords.mjs",
      "version": 5,
      "enabled": true,
      "execution_type": "node",
      "timeout_seconds": 900,
      "retry_count": 0,
      "default_config": {
        "category_url": "https://tophub.today/c/news",
        "wechat_node_url": "https://tophub.today/n/WnBe01o371",
        "max_hotwords": 5,
        "min_platform_count": 2,
        "merge_consistency_threshold": 0.8,
        "merge_min_article_count": 3,
        "title_overlap_threshold": 0.8,
        "canonical_hotwords": [
          {
            "canonical": "闲鱼",
            "match_type": "prefix",
            "protected": true
          }
