    "tophub-hotwords": { "config": { "category_url": { "type": "string", "label": "新闻分类页" }, "wechat_node_url": { "type": "string", "label": "微信24h热文榜" }, "max_hotwords": { "type": "integer", "label": "热词数量上限", "min": 1, "max": 100 }, "min_platform_count": { "type": "integer", "label": "最少命中平台数", "min": 2, "max": 50 }, "canonical_hotwords": { "type": "array", "label": "固定热词归并规则", "description": "例如闲鱼使用prefix将闲鱼暗、闲鱼公等候选归并到闲鱼，并保留matched_terms证据。" }, "merge_consistency_threshold": { "type": "number", "label": "相似热词合并一致性阈值", "description": "0.8 示例：相似热词的文章证据一致性达到 80% 才合并；如“体操男团/体操男”共同覆盖 4/5 篇文章时合并。", "min": 0, "max": 1 }, "merge_min_article_count": { "type": "integer", "label": "相似热词最少交叉文章数", "description": "默认 3 篇。示例：两个热词至少共同出现在 3 篇文章中，才进入一致性合并；共同 2 篇不合并。", "min": 1, "max": 100 }, "title_overlap_threshold": { "type": "number", "label": "跨平台标题去重重叠度", "description": "0.8 示例：跨平台规范化标题字符重叠达到 80% 才去重；“亚运会夺冠/亚运会夺冠了”约 83.3%，会合并；同平台文章不按此值去重。", "min": 0, "max": 1 }, "stat_date": { "type": "date", "label": "统计日期" } }, "required_artifacts": [] },
    "redfox-gzh": {"config":{"target_date":{"type":"date","label":"目标日期"},"lookback_days":{"type":"integer","label":"回溯天数","min":0,"max":31},"start_date":{"type":"date","label":"开始日期"},"end_date":{"type":"date","label":"结束日期"}},"required_artifacts":[]},
    "accounts-update": { "config": {}, "required_artifacts": [{ "artifact_type": "accounts", "schema_version": "1", "required": true }] },
    "hotwords-update": { "config": { "stat_date": { "type": "date", "label": "统计日期" }, "canonical_hotwords": { "type": "array", "label": "固定热词归并规则", "description": "例如闲鱼使用prefix将闲鱼暗、闲鱼公等候选归并到闲鱼，并保留matched_terms证据。" }, "merge_consistency_threshold": { "type": "number", "label": "相似热词合并一致性阈值", "description": "0.8 示例：相似热词的文章证据一致性达到 80% 才合并；如“体操男团/体操男”共同覆盖 4/5 篇文章时合并。", "min": 0, "max": 1 }, "merge_min_article_count": { "type": "integer", "label": "相似热词最少交叉文章数", "description": "默认 3 篇。示例：两个热词至少共同出现在 3 篇文章中，才进入一致性合并；共同 2 篇不合并。", "min": 1, "max": 100 } }, "required_artifacts": [{ "artifact_type": "articles", "schema_version": "1", "required": true }] },
    "articles-filter": { "config": { "run_date": { "type": "date", "label": "运行日期" } }, "required_artifacts": [{ "artifact_type": "accounts", "schema_version": "1", "required": true }, { "artifact_type": "articles", "schema_version": "1", "required": true }] },
    "wxrank-strategy": { "config": { "request_types": { "type": "multi_enum", "label": "执行策略", "description": "单独验证最多选择一个；工作流可按保存的多选策略全部执行。", "options": [{ "value": "account", "label": "账号策略" }, { "value": "wx_type", "label": "类型策略" }], "min": 1, "max": 2 } }, "required_artifacts": [] },
    "publish-results": { "config": { "publish_mode": { "type": "enum", "options": ["none", "preview", "commit"] } }, "required_artifacts": [{ "artifact_type": "write_set", "schema_version": "1", "required": true }] }
  }
}
