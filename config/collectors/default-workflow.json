      "seq": 20,
      "script_key": "article-collect",
      "enabled": true,
      "config_override": {
        "range": "7d",
        "page": 1
      },
      "condition": null,
      "continue_on_error": true,
      "retry_count": 0,
      "timeout_seconds": 1800
    },
    {
